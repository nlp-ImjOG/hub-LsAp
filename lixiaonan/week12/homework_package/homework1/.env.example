# 复制为 .env 并填写。API Key 仅存于后端，前端不接触。

# 智谱开放平台 API Key（https://open.bigmodel.cn）
API_KEY=

# 模型名。若调用报"模型不存在(404)"，可切换为 glm-4.1v-thinking-flash
MODEL=glm-4.1v-flash

# OpenAI 兼容接口地址（智谱）
BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 图片约束
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_SIDE=2048

# 模型请求超时（秒）
REQUEST_TIMEOUT=60
