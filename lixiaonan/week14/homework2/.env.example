# ============ 服务 ============
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# ============ Kafka（功能1：任务分发）============
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC_PARSE_TASK=pdf-parse-task
KAFKA_CONSUMER_GROUP=pdf-parse-worker
KAFKA_MAX_RETRY=3
STALE_PARSING_MINUTES=30                # F2-4：PARSING 超时兜底阈值（分钟，0=禁用）
STALE_CHECK_INTERVAL_SECONDS=60         # 兜底检查周期

# ============ 数据库（SQLite 相对路径基于项目根 data/）============
DATABASE_URL=sqlite:///./data/homework2.db
# 生产/联调可切换 MySQL：
# DATABASE_URL=mysql+pymysql://root:root123@localhost:3306/multimodal_rag?charset=utf8mb4

# ============ 存储 ============
STORAGE_BACKEND=local                # local | minio
DATA_DIR=./data
STATIC_URL_PREFIX=/static
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=homework2

# ============ 解析（功能1 / F1-7）============
# mineru   : 需要 pip install "mineru[core]"（4.x，无 GPU 可用 CPU 模式），
#            且先执行 `mineru server start` 启动本地解析引擎（首次自动下载模型，
#            MINERU_MODEL_SOURCE=modelscope 走国内源；引擎档位默认 basic，可用
#            `mineru config set parse_server.local.managed_tier standard` 升级）
# pymupdf : 降级方案，无需额外依赖，无版面分析
PARSER_BACKEND=mineru
MINERU_CMD=mineru parse {input} -o {output}/result.md --pages all --force --wait 540
MINERU_TIMEOUT_SECONDS=900
MINERU_MODEL_SOURCE=modelscope       # 模型权重下载源：modelscope|huggingface（国内网络建议 modelscope）

# 分块参数（F1-8）
CHUNK_MIN_CHARS=300
CHUNK_MAX_CHARS=1200

# ============ 上传限制（F1-2 / F1-9）============
MAX_UPLOAD_SIZE_MB=50
MAX_UPLOAD_COUNT=10
ALLOW_DUPLICATE=true

# ============ 向量化（F1-8 / F3-3 检索）============
EMBEDDING_ENABLED=true
EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5   # 轻量中文模型 512 维；要求更高可换 BAAI/bge-m3（1024 维）
EMBEDDING_DIM=512
HF_ENDPOINT=https://hf-mirror.com        # HuggingFace 国内镜像，留空不设置
EMBEDDING_IMAGE_CAPTION=false            # 解析时用多模态 LLM 生成图片描述（需真实 LLM，提升图片召回）

# ============ 多模态 LLM（功能3：问答）============
LLM_BACKEND=mock                         # openai（OpenAI 兼容协议）| mock（无 Key 联调桩）
LLM_API_BASE=https://open.bigmodel.cn/api/paas/v4   # 智谱；dashscope 用 https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_API_KEY=sk-xxx
LLM_MODEL=glm-4.5v                       # 必须为多模态模型（glm-4.5v / qwen2.5-vl-* 等）
LLM_MAX_TOKENS=4096                      # 思考模型正文与 reasoning 共享额度，需留足
LLM_THINKING_EFFORT=low                  # 思考模型档位 low/high/max；非思考模型请置空（不传该参数）

# ============ 检索（F3-3）============
RETRIEVAL_TOP_K=5
