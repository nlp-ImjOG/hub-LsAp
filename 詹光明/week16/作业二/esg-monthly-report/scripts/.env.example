# 复制为 .env 后填写。.env 已在 .gitignore 中，不会入库。

# ── 博查 Web Search ──────────────────────────────────────────
# 申请地址: https://open.bochaai.com/
BOCHA_API_KEY=
BOCHA_BASE_URL=https://api.bocha.cn/v1/web-search

# ── LLM（OpenAI 兼容 / DeepSeek 等）─────────────────────────
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 可选覆盖 ────────────────────────────────────────────────
# SEARCH_COUNT=10
# MAX_SOURCES=15
# FETCH_ENABLED=true
# LLM_TEMPERATURE=0.2
