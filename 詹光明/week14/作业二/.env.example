# 复制为 .env 后按需修改

# ---------------- Kafka ----------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=rag-data
KAFKA_GROUP_ID=rag-parse-worker

# ---------------- Milvus ----------------
# Linux/macOS 可以用本地文件（Milvus Lite）：
# MILVUS_URI=./milvus.db
# Windows / 远程集群：
# MILVUS_URI=https://xxx.serverless.ali-cn-hangzhou.cloud.zilliz.com.cn
# MILVUS_TOKEN=xxxx
MILVUS_COLLECTION=rag_multimodal

# ---------------- 向量模型 ----------------
# 支持 HuggingFace 仓库名或本地目录
BGE_MODEL=BAAI/bge-small-zh-v1.5
CLIP_MODEL=jinaai/jina-clip-v2
CLIP_TRUNCATE_DIM=1024
BGE_DIM=512
CLIP_DIM=1024
# EMBEDDING_DEVICE=cuda
HF_ENDPOINT=https://hf-mirror.com

# ---------------- PDF 解析 ----------------
# mineru: 调 MinerU 解析（推荐）
# pymupdf: 本机没有 MinerU 时的兜底方案
PARSER_BACKEND=mineru
# auto 自动识别；也可显式指定 flat(2.x/3.x) / kit(4.x,含图片) / parse(4.x,仅markdown)
MINERU_MODE=auto
MINERU_CMD=mineru
MINERU_KIT_CMD=mineru-kit
# flat 模式的后端：pipeline / vlm-http-client ...
MINERU_BACKEND=pipeline
# kit 模式的质量档位：flash / basic / standard / advanced
MINERU_TIER=standard
# 使用 vlm-http-client 后端时填写 MinerU 服务地址
MINERU_API_URL=http://127.0.0.1:30000
PARSE_TIMEOUT=1200
CHUNK_SIZE=256

# ---------------- 检索 ----------------
TOP_K=5
MAX_CONTEXT_CHARS=8000
MAX_CONTEXT_IMAGES=3
MAX_USER_IMAGES=3

# ---------------- 多模态大模型 ----------------
# DashScope 控制台申请：https://dashscope.console.aliyun.com/
LLM_API_KEY=sk-03296fdf65e847278eb8414cc89cb752
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max-latest
LLM_TEMPERATURE=0.2
