# 复制本文件为 .env 并填入你的 API Key（至少填一个供应商即可使用）

# DeepSeek Flash V4.1（在 https://platform.deepseek.com 申请）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_MODEL=deepseek-flash

# 通义千问 Qwen-VL（在 https://bailian.console.aliyun.com 申请）
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
DASHSCOPE_MODEL=qwen-vl-max-latest
