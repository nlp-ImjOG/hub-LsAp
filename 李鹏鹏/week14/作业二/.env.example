# ============================================================================
# 多模态 RAG 文档问答 · 环境变量模板
# ----------------------------------------------------------------------------
# 复制为 .env 后按需修改：cp .env.example .env
# 所有变量都可省略，省略时使用括号内的默认值。
# 注意：值后面不要写行内注释，注释请单独一行。
# ============================================================================

# ------------------------------- 站点 ---------------------------------------
HOST=0.0.0.0
PORT=8000
# 启动后自动打开浏览器：1 打开，0 不打开
OPEN_BROWSER=0
# 数据目录（上传文件、解析结果、SQLite）
DATA_DIR=./data
# 单文件上传上限（MB）
MAX_UPLOAD_MB=60

# ------------------------------- Kafka --------------------------------------
# 实验环境：172.30.0.4 的 9094 是对外通告端口（9092 通告的是 localhost，外网连不上）
KAFKA_ENABLED=1
KAFKA_BOOTSTRAP=172.30.0.4:9094
KAFKA_PARSE_TOPIC=rag.doc.parse
KAFKA_STATUS_TOPIC=rag.doc.status
KAFKA_GROUP=rag-parser
KAFKA_PARTITIONS=3
KAFKA_REPLICAS=1
# Kafka 不可用时退化为进程内直连队列（1 开，0 关）
KAFKA_FALLBACK_DIRECT=1
# Web 进程内是否内嵌解析 worker（1 开；生产可设 0 并单独运行 python -m app.worker）
EMBED_WORKER=1

# ------------------------------- PDF 解析 -----------------------------------
# auto：优先 MinerU，不可用时自动降级内置解析器
# mineru：强制 MinerU（未安装会直接报错，答辩演示推荐）
# lite：强制内置解析器（零模型下载，克隆即跑）
PARSER_BACKEND=auto
MINERU_COMMAND=mineru
MINERU_BACKEND=pipeline
MINERU_METHOD=auto
MINERU_LANG=ch
MINERU_TIMEOUT=1800
# 如果 MinerU 以 HTTP 服务方式部署（mineru-api），填服务地址即可走接口
# MINERU_API_URL=http://127.0.0.1:8000
# MINERU_API_TOKEN=
# 自定义 MinerU 命令模板，占位符需独占一个参数
# MINERU_CMD_TEMPLATE={mineru} -p {input} -o {output} -b {backend} -m {method} -l {lang}

# 页面图 / 图片裁切分辨率（越大越清晰，磁盘占用也越大）
PAGE_IMAGE_DPI=120
FIGURE_IMAGE_DPI=170

# ------------------------------- 切块 ---------------------------------------
CHUNK_SIZE=700
CHUNK_OVERLAP=120
FIGURE_CONTEXT_CHARS=260

# ------------------------------- 检索 ---------------------------------------
RAG_TOP_K=6
RAG_FIGURE_TOP_K=3
RAG_MAX_CONTEXT_CHARS=9000
RAG_MAX_IMAGES=4
# bm25：纯关键词检索（默认，零模型下载）；hybrid：BM25 + 句向量
RETRIEVAL_MODE=bm25
# 需要 hybrid 时填一个中文句向量模型，并安装 sentence-transformers
# EMBEDDING_MODEL=BAAI/bge-small-zh-v1.5
# EMBEDDING_DEVICE=cpu
# 需要「文字直接检索图片」时填 CLIP 模型，并安装 sentence-transformers
# MULTIMODAL_EMBEDDING_MODEL=clip-ViT-B-32
# 命中图片/页面截图是否一起送进多模态模型
RAG_ATTACH_FIGURES=1
RAG_ATTACH_PAGES=0
# 图问时是否先生成图片描述再检索
RAG_CAPTION_QUERY=1
RAG_IMAGE_MAX_SIDE=1100

# ------------------------------- 大模型 -------------------------------------
# 任何 OpenAI 兼容服务都可以：qwen / openai / deepseek / custom
LLM_PROVIDER=qwen
# 阿里云百炼（DashScope 兼容模式）示例
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen-vl-max-latest
LLM_VISION_MODEL=qwen-vl-max-latest
# API Key 两种写法二选一：通用 LLM_API_KEY，或服务商专属 QWEN_API_KEY
LLM_API_KEY=
# QWEN_API_KEY=
LLM_TIMEOUT=120
LLM_MAX_TOKENS=2048
LLM_TEMPERATURE=0.2
# 额外请求参数（JSON 字符串），例如关闭 Qwen3 思考模式
# LLM_EXTRA_BODY={"enable_thinking": false}
# 离线演示：1 表示不调用真实模型，用检索结果拼装演示答案（无 Key 时也能跑通全链路）
LLM_MOCK=0

# ------------------------------- 调试 ---------------------------------------
DEBUG=0
WORKER_POLL_MS=500