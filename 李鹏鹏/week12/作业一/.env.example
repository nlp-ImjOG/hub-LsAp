# ============================================================
# 楼道哨兵 · 模型与服务配置
# 复制本文件为 .env，填写至少一个模型的 API Key。
# ============================================================

# 默认使用哪个模型：qwen | deepseek
DEFAULT_PROVIDER=qwen

# ---------- Qwen VL（阿里云百炼 DashScope，OpenAI 兼容接口） ----------
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen-vl-max-latest

# ---------- DeepSeek Flash 4.1（OpenAI 兼容接口） ----------
# 如你的 DeepSeek 服务使用其他模型 ID，请修改 DEEPSEEK_MODEL
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4.1-flash

# ---------- 服务参数 ----------
HOST=0.0.0.0
PORT=8000
# 上传大小上限（MB）
MAX_UPLOAD_MB=12
# 送入模型前的最长边（像素）
MAX_IMAGE_SIDE=1600
# 模型请求超时（秒）
REQUEST_TIMEOUT=90
# 启动后是否自动打开浏览器：1 打开 | 0 不打开
OPEN_BROWSER=1
