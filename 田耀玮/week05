# -*- coding: utf-8 -*-
"""
bge 文本检索示例（无需 ES）
- 用 sentence-transformers 加载本地 bge 模型
- 把 query 和语料都编码成向量，用余弦相似度排序返回最相关文本
"""
import os
from sentence_transformers import SentenceTransformer

# 模型目录（相对本脚本位置，确保路径稳健）
BASE = os.path.dirname(os.path.abspath(__file__))
MODEL_DIR = os.path.join(BASE, "BAAI", "bge-small-zh-v1.5")

# 待检索的 query
QUERY = "我今天很开心"

# 数据库文本（语料）
CORPUS = [
    "我喜欢机器学习",
    "我喜欢深度学习",
    "我今天心情很不错",
]

# bge 检索建议：给 query 加指令前缀，能显著提升中文检索效果
# 注意：只加在 query 上，语料不加
QUERY_INSTRUCTION = "为这个句子生成表示以用于检索相关文章："

def main():
    print(f"加载模型: {MODEL_DIR}")
    model = SentenceTransformer(MODEL_DIR)

    # 编码时 normalize_embeddings=True，使余弦相似度等价于向量内积
    q_emb = model.encode(QUERY_INSTRUCTION + QUERY, normalize_embeddings=True)
    c_emb = model.encode(CORPUS, normalize_embeddings=True)

    # 相似度矩阵（已归一化 => 余弦相似度 = 点积）
    scores = c_emb @ q_emb

    # 按相似度从高到低排序
    ranked = sorted(zip(CORPUS, scores), key=lambda x: x[1], reverse=True)

    print(f"\nQuery: {QUERY}\n")
    print("相似度排序结果（从高到低）：")
    for text, score in ranked:
        print(f"  {score:.4f}   {text}")

if __name__ == "__main__":
    main()




