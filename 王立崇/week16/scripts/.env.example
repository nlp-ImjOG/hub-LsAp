# 复制为 scripts/.env 后填写。全部留空也能跑：编排脚本会用 --demo 或规则模式。

# ---- LLM（OpenAI 兼容，DeepSeek 只填 DEEPSEEK_API_KEY 即可）----
# DEEPSEEK_API_KEY=sk-xxxx
# OPENAI_API_KEY=sk-xxxx
# OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# OPENAI_MODEL=qwen-plus

# ---- 搜索后端（二选一）----
# SERPER_API_KEY=xxxx          # https://serper.dev （Google）
# BOCHA_API_KEY=sk-xxxx        # https://open.bochaai.com （中文搜索，推荐）

# ---- 推送（daily 模式可选）----
# WECOM_WEBHOOK=https://qyapi.weixin.qq.com/cgi-bin/webhook/send?key=xxxx
# DINGTALK_WEBHOOK=https://oapi.dingtalk.com/robot/send?access_token=xxxx

# ---- 其它 ----
# LLM_TIMEOUT=60
