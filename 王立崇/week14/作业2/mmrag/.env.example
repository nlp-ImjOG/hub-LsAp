# Copy to .env and adjust for your machine. Existing shell variables take
# precedence over values in .env (config.py uses setdefault).

# --- Web ---------------------------------------------------------------------
MMRAG_HOST=0.0.0.0
MMRAG_PORT=8080

# --- Kafka -------------------------------------------------------------------
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
MMRAG_INGEST_TOPIC=mmrag.ingest
MMRAG_STATUS_TOPIC=mmrag.status
MMRAG_WORKER_GROUP=mmrag-ingest-workers
MMRAG_API_EVENT_GROUP=mmrag-api-events

# --- MinerU ------------------------------------------------------------------
# The local vLLM process occupies most of the GPU, so advanced is not reliable
# here. The worker still tries the requested tier first, then falls back to basic.
MINERU_BIN=/usr/local/miniconda3/envs/py312/bin/mineru-kit
MINERU_TIER=basic
MINERU_FALLBACK_TIER=basic
MINERU_TIMEOUT_SECONDS=1800

# --- OpenAI-compatible multimodal model (vLLM) -------------------------------
LLM_BASE_URL=http://localhost:8000/v1
LLM_API_KEY=EMPTY
# The exact id returned by GET /v1/models; note the trailing slash in this env.
LLM_MODEL=models/Qwen3.5-0.8B/
LLM_VISION_MODEL=models/Qwen3.5-0.8B/
LLM_TIMEOUT_SECONDS=180

# --- Ingestion / retrieval ---------------------------------------------------
MMRAG_CAPTION_IMAGES=true
MMRAG_CAPTION_CONCURRENCY=2
MMRAG_CAPTION_MAX_EDGE=1280
MMRAG_CAPTION_TIMEOUT_SECONDS=60
MMRAG_QUERY_IMAGE_TIMEOUT_SECONDS=45
MMRAG_DOCUMENT_MAX_MB=100
MMRAG_CHAT_IMAGE_MAX_MB=10
MMRAG_QUERY_IMAGE_AUGMENT=true
MMRAG_RETRIEVAL_TEXT_TOP_K=6
MMRAG_RETRIEVAL_IMAGE_TOP_K=4
MMRAG_RETRIEVAL_CANDIDATES=40
MMRAG_MAX_CONTEXT_CHARS=9000
MMRAG_MAX_VISION_CONTEXTS=3
MMRAG_MAX_HISTORY_TURNS=6
MMRAG_LLM_MAX_TOKENS=1400
LOG_LEVEL=INFO

# Optional: move all generated files and the SQLite database elsewhere.
# MMRAG_DATA_DIR=/workspace/mmrag/data
# MMRAG_DB_PATH=/workspace/mmrag/data/mmrag.db
