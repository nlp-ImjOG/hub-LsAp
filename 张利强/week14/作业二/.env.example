# ---- 必填：智谱 API Key（https://open.bigmodel.cn） ----
ZHIPU_API_KEY=

# ---- 模型 ----
LLM_MODEL=glm-4v-flash
LLM_FALLBACK_MODEL=
EMBED_MODEL=embedding-3
EMBED_DIM=1024

# ---- Kafka ----
KAFKA_BOOTSTRAP=127.0.0.1:9092
KAFKA_TOPIC_PARSE=pdf-parse
KAFKA_TOPIC_DLQ=pdf-parse-dlq
KAFKA_TOPIC_STATUS=doc-status

# ---- Elasticsearch ----
ES_URL=http://127.0.0.1:9200
ES_INDEX=rag_chunks_v1

# ---- MinerU ----
MINERU_BIN=/opt/anaconda3/envs/py312/bin/mineru
MINERU_TIER=flash
MINERU_TIMEOUT=1800

# ---- 业务参数 ----
MAX_UPLOAD_MB=50
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TOP_K=6

# ---- 调试开关（无 Key 时自动 mock） ----
MOCK_LLM=false
MOCK_EMBEDDING=false
