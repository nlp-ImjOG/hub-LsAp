# 复制本文件为 .env 后填写真实配置（.env 已被 .gitignore 忽略）

# 阿里云百炼（DashScope）OpenAI 兼容接口
DASHSCOPE_API_KEY=sk-在这里填写你的Key
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=deepseek-v4.1-flash

# 没有可用 Key 时置 1，用规则生成的示例结果跑通前后端流程
MOCK_MODE=0

# 图片与请求限制（推理型模型需要较大的输出上限）
MAX_IMAGE_MB=10
REQUEST_TIMEOUT=90
IMAGE_MAX_SIDE=1280
JPEG_QUALITY=85
MAX_OUTPUT_TOKENS=3000
